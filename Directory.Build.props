<Project>
  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)build/artifacts</ArtifactsPath>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PathMap Condition="'$(ContinuousIntegrationBuild)' == 'true'">$(MSBuildThisFileDirectory)=/_/,$(ArtifactsPath)=/_/artifacts/</PathMap>
    <Version>1.0.0</Version>
    <Authors>Devantix</Authors>
    <Company>Devantix</Company>
    <Copyright>Copyright (c) 2026 Devantix</Copyright>
    <Product>FocusRGB Steam Plugin</Product>
  </PropertyGroup>
</Project>
